<div class="layout layout--col gap">
  {% comment %} Taller than wide in both orientations: art over text, doors down the right side {% endcomment %}
  <div class="advent-body flex flex--row gap">
  <div class="advent-main flex flex--col flex--center-x flex--center-y gap--medium">
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% if state == "offseason" %}
        {% render "door_art", door: 0 %}
      {% else %}
        {% render "door_art", door: door %}
      {% endif %}
    </div>
    <div class="flex flex--col flex--center-x text--center">
      {% if state == "offseason" %}
      <span class="value value--xxlarge portrait:value--xlarge">{{ days_until_advent }}</span>
      <span class="title title--large">{% if days_until_advent == 1 %}day{% else %}days{% endif %} until</span>
      <span class="title title--large">Advent</span>
      {% else %}
      <span class="value value--xxlarge portrait:value--xlarge">{{ day }}</span>
      <span class="title title--large">December</span>
      <span class="title">
        {% if state == "christmas" %}
          Merry Christmas!
        {% else %}
          <b>{{ days_until_christmas }}</b> {% if days_until_christmas == 1 %}day{% else %}days{% endif %} to go
        {% endif %}
      </span>
      {% endif %}
    </div>
  </div>
  {% unless state == "offseason" %}
  {% render "doors", door: door, vertical: true %}
  {% endunless %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Advent Calendar</span>
</div>
