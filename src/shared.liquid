{% comment %}
  Date logic. Outputs:
    state                 "advent" | "christmas" | "offseason"
    door                  1-25 (advent/christmas only)
    days_until_christmas  24..0 (advent/christmas only)
    days_until_advent     days until the next Dec 1 (offseason only)
{% endcomment %}

{% comment %} TRMNL's days_ago returns a Date in the given zone, so 0 days ago is the user's local today {% endcomment %}
{% assign today = 0 | days_ago: trmnl.user.time_zone_iana %}
{% assign year = today | date: "%Y" | plus: 0 %}
{% assign month = today | date: "%-m" | plus: 0 %}
{% assign day = today | date: "%-d" | plus: 0 %}

{% if month == 12 and day <= 24 %}
  {% assign state = "advent" %}
  {% assign door = day %}
  {% assign days_until_christmas = 25 | minus: day %}
{% elsif month == 12 and day == 25 %}
  {% assign state = "christmas" %}
  {% assign door = 25 %}
  {% assign days_until_christmas = 0 %}
{% else %}
  {% assign state = "offseason" %}
  {% if month == 12 %}
    {% assign target_year = year | plus: 1 %}
  {% else %}
    {% assign target_year = year %}
  {% endif %}
  {% comment %} Both sides are midnight UTC, so the difference is a whole number of days {% endcomment %}
  {% assign target_seconds = target_year | append: "-12-01T00:00:00Z" | date: "%s" %}
  {% assign today_seconds = today | date: "%s" %}
  {% assign days_until_advent = target_seconds | minus: today_seconds | divided_by: 86400 %}
{% endif %}

{% comment %} Item name for today's door {% endcomment %}
{% assign door_names = "Snowflake,Mitten,Hot Cocoa,Penguin,Candy Cane,Pinecone,Snowman,Ice Skates,Polar Bear,Gingerbread Man,Ugly Sweater,Sled,Snow Globe,Holly,Reindeer,Stocking,Nutcracker,Ornament,Wreath,Elf,Present,Gingerbread House,Cookies and Milk,Santa's Sleigh,Christmas Tree" | split: "," %}
{% if door %}
  {% assign door_index = door | minus: 1 %}
  {% assign door_name = door_names[door_index] %}
{% endif %}

<style>
  /* Framework CSS is in @layers, so anything here beats it: don't set display, or classes like portrait:hidden stop working */
  .advent-main { flex: 1; min-height: 0; }
  .advent-art {
    height: 100%;
    aspect-ratio: 1;
    border: 4px solid currentColor;
    border-radius: 16px;
  }
  /* Portrait half horizontal is taller than wide: size the art by width so the text has room */
  .screen--portrait .view--half_horizontal .advent-art { height: auto; width: 45%; align-self: center; }
  .advent-drawing { width: 85%; height: 85%; }
  .advent-art--mirrored .advent-drawing { transform: scaleX(-1); }
  /* Shapes filled with the screen background: white, or black in dark mode */
  .advent-drawing .paper { fill: var(--framework-semantic-canvas-bg-color, white); }
  .advent-doors { width: 100%; height: auto; flex-shrink: 0; }
  /* Compact: thicker strokes, and no ring (the last opened door is today) */
  .advent-doors--compact rect { stroke-width: 6; }
  .advent-doors--compact .advent-doors__ring { display: none; }
</style>

{% comment %} Progress row. Usage: {% render "doors", door: door %}; add compact: true at small sizes {% endcomment %}
{% template doors %}
<svg class="advent-doors{% if compact %} advent-doors--compact{% endif %}" viewBox="0 0 750 32">
  {% comment %} Doors: opened (outlined) up to today, today ringed, closed (solid) after {% endcomment %}
  {% for i in (1..25) %}
    {% assign x = i | times: 30 | minus: 23 %}
    {% if i <= door %}
      <rect x="{{ x }}" y="9" width="14" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="3" />
      {% if i == door %}
        {% assign ring_x = x | minus: 6 %}
        <rect class="advent-doors__ring" x="{{ ring_x }}" y="3" width="26" height="26" rx="4" fill="none" stroke="currentColor" stroke-width="3" />
      {% endif %}
    {% else %}
      <rect x="{{ x | minus: 1 }}" y="8" width="16" height="16" rx="2" fill="currentColor" />
    {% endif %}
  {% endfor %}
</svg>
{% endtemplate %}

{% comment %} ==================== Art ==================== {% endcomment %}

{% comment %} Today's drawing. Usage: {% render "door_art", door: door, door_name: door_name %} {% endcomment %}
{% template door_art %}
{% case door %}
{% when 7 %}
<svg class="advent-drawing" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
  <!-- stick arms -->
  <path d="M70 100 L36 78 M46 84 L40 66" />
  <path d="M130 100 L164 78 M154 84 L162 68" />
  <!-- body -->
  <circle cx="100" cy="154" r="40" class="paper" />
  <circle cx="100" cy="100" r="30" class="paper" />
  <circle cx="100" cy="56" r="25" class="paper" />
  <!-- scarf -->
  <path d="M76 79 Q100 89 124 79" stroke-width="12" />
  <path d="M112 84 L118 110" stroke-width="12" />
  <!-- top hat -->
  <path d="M70 34 H130" stroke-width="10" />
  <rect x="82" y="6" width="36" height="26" rx="3" fill="currentColor" />
  <!-- face -->
  <circle cx="91" cy="49" r="4" fill="currentColor" stroke="none" />
  <circle cx="109" cy="49" r="4" fill="currentColor" stroke="none" />
  <path d="M100 55 L123 58 L100 61 Z" fill="currentColor" stroke-width="3" />
  <path d="M90 67 Q100 73 110 67" stroke-width="4" />
  <!-- buttons -->
  <circle cx="100" cy="96" r="4.5" fill="currentColor" stroke="none" />
  <circle cx="100" cy="112" r="4.5" fill="currentColor" stroke="none" />
  <circle cx="100" cy="146" r="4.5" fill="currentColor" stroke="none" />
</svg>
{% else %}
<span class="label">{{ door_name }}</span>
{% endcase %}
{% endtemplate %}
