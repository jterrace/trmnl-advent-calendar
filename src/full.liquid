<div class="layout layout--col gap--medium">
  {% if state == "offseason" %}
  <div class="advent-main flex flex--row gap--xlarge w--full portrait:flex--col portrait:flex--center-x">
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% render "door_art", door: 0 %}
    </div>
    <div class="flex flex--col flex--center-y flex--left gap--small flex-auto portrait:flex--center-x">
      <span class="value value--mega">{{ days_until_advent }}</span>
      <span class="title title--xlarge">{% if days_until_advent == 1 %}day{% else %}days{% endif %} until the</span>
      <span class="title title--xlarge">Advent Calendar</span>
    </div>
  </div>
  {% else %}
  {% comment %} Doors below in landscape, down the right side in portrait {% endcomment %}
  <div class="advent-body flex flex--col gap--medium portrait:flex--row">
  <div class="advent-main flex flex--row gap--xlarge w--full portrait:flex--col portrait:flex--center-x">
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% render "door_art", door: door %}
    </div>
    <div class="flex flex--col flex--center-y flex--left gap--small flex-auto portrait:flex--center-x">
      <span class="value value--mega">{{ day }}</span>
      <span class="title title--xlarge">December</span>
      <span class="title title--large">
        {% if state == "christmas" %}
          Merry Christmas!
        {% else %}
          <b>{{ days_until_christmas }}</b> {% if days_until_christmas == 1 %}day{% else %}days{% endif %} until Christmas
        {% endif %}
      </span>
      <span class="label label--xlarge label--inverted">{{ door_name }}</span>
    </div>
  </div>

  {% render "doors", door: door, class: "portrait:hidden" %}
  {% render "doors", door: door, vertical: true, class: "landscape:hidden" %}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Advent Calendar</span>
</div>
