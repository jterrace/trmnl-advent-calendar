<div class="layout layout--col gap">
  {% comment %} Doors below in landscape, down the right side in portrait {% endcomment %}
  <div class="advent-body flex flex--col gap portrait:flex--row">
  <div class="advent-main flex flex--row gap--medium w--full portrait:flex--col portrait:flex--center-x">
    {% if state == "offseason" %}
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% render "door_art", door: 0 %}
    </div>
    <div class="flex flex--col flex--center-y flex--left flex-auto portrait:flex--center-x">
      <span class="value value--xlarge lg:value--xxlarge">{{ days_until_advent }}</span>
      <span class="title lg:title--large">{% if days_until_advent == 1 %}day{% else %}days{% endif %} until</span>
      <span class="title lg:title--large">Advent</span>
    </div>
    {% else %}
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% render "door_art", door: door %}
    </div>
    <div class="flex flex--col flex--center-y flex--left flex-auto portrait:flex--center-x">
      <span class="value value--xlarge lg:value--xxlarge">{{ day }}</span>
      <span class="title lg:title--large">December</span>
      <span class="title title--small lg:title--base">
        {% if state == "christmas" %}
          Merry Christmas!
        {% else %}
          <b>{{ days_until_christmas }}</b> {% if days_until_christmas == 1 %}day{% else %}days{% endif %} to go
        {% endif %}
      </span>
    </div>
    {% endif %}
  </div>
  {% unless state == "offseason" %}
  {% render "doors", door: door, compact: true, class: "portrait:hidden" %}
  {% render "doors", door: door, compact: true, vertical: true, class: "landscape:hidden" %}
  {% endunless %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Advent Calendar</span>
</div>
