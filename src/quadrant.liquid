<div class="layout layout--col gap">
  <div class="advent-main flex flex--row gap--medium w--full portrait:flex--col portrait:flex--center-x">
    {% if state == "offseason" %}
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      <span class="label label--small">Sleeping Santa</span>
    </div>
    <div class="flex flex--col flex--center-y flex--left flex-auto portrait:flex--center-x">
      <span class="value value--xlarge">{{ days_until_advent }}</span>
      <span class="title">{% if days_until_advent == 1 %}day{% else %}days{% endif %} until</span>
      <span class="title">Advent</span>
    </div>
    {% else %}
    <div class="advent-art flex flex--center-x flex--center-y flex-none">
      {% render "door_art", door: door, door_name: door_name %}
    </div>
    <div class="flex flex--col flex--center-y flex--left flex-auto portrait:flex--center-x">
      <span class="value value--xlarge">{{ day }}</span>
      <span class="title">December</span>
      <span class="title title--small">
        {% if state == "christmas" %}
          Merry Christmas!
        {% else %}
          <b>{{ days_until_christmas }}</b> {% if days_until_christmas == 1 %}day{% else %}days{% endif %} to go
        {% endif %}
      </span>
    </div>
    {% endif %}
  </div>
  {% unless state == "offseason" %}
  {% render "doors", door: door, compact: true %}
  {% endunless %}
</div>

<div class="title_bar">
  <span class="title">Advent Calendar</span>
</div>
